[Unit]
Description=Report A2DP and BLE input activity to the RTL8852BD Bluetooth firmware (Wi-Fi/BT coexistence)
Documentation=https://github.com/Shuvam-Banerji-Seal/rtl8852bd-bt-dkms
After=bluetooth.service
Wants=bluetooth.service

[Service]
ExecStart=/usr/lib/rtl8852bd-bt/rtl8852bd-coexd
Restart=on-failure
RestartSec=5
# raw HCI sockets (link events) need CAP_NET_RAW; MGMT_OP_HCI_CMD_SYNC, which
# sends the vendor command in order with the kernel's own, needs CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_BLUETOOTH AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=bluetooth.target
